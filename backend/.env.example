# Flask Server Configuration
SECRET_KEY=your_flask_secret_key_here
DEBUG=True
PORT=5000

# Database Configuration (Optional: defaults to SQLite fraudshield.db if MySQL is offline)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=fraudshield_db

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRY_HOURS=24
